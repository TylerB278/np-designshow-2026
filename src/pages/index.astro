---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
const allPeople = await getCollection("people");
import PeopleMarquee from "../components/PeopleMarquee.astro";
import ProjectLister from "../components/ProjectLister.astro";
import Placeholder from "../assets/bg-placeholder.png";
import HeaderLong from "../assets/site-logo-long.webp";
import HeaderSquare from "../assets/site-logo-square.webp";
import HeaderTall from "../assets/site-logo-tall.webp";
import HeaderBG from "../assets/site-header-bg.webp";
---

<Layout pageTitle="Home">
  <!-- <PeopleMarquee /> -->
  <section class="welcome">
    <div class="title-box">
      <Image src={HeaderLong} alt="header image" class="headerImg long"/>
      <Image src={HeaderSquare} alt="header image" class="headerImg square"/>
      <Image src={HeaderTall} alt="header image" class="headerImg tall"/>
    </div>
  </section>
  <div class="welcomeBG">
    <Image src={HeaderBG} alt="header image" class="bg-head"/> 
  </div>
  <!-- <PeopleMarquee reverse /> -->
  <h2 class="big-header star-after">PROJECTS</h2>
  <ProjectLister />
</Layout>

<style>
  .headerImg{
    padding: 80px;
    width: 100%;
    max-width: 1500px;
    animation: Intro 1s 0.5s ease-out both;
  }

  .bg-head{
    position: absolute;
    width: 100%;
    max-width: 1500px;
    transform-origin: center;
    animation: IntroBG 1s 0.6s ease-out both;
  }
  .welcomeBG{
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    height: 90vh;
    animation: IntroBGIdle 1s 1.6s ease-in-out infinite;
    z-index: -1;
  }

  @media (min-width: 970px){
  .bg-head{ rotate: 90deg; padding: 120px;}
  .long{ display: block; padding: 80px; }
  .square{ display: none; }
  .tall{ display: none; }
}

  @media (max-width: 970px){
    .bg-head{ transform: scale(88%); padding: 0px;}
    .long{ display: none; }
    .square{ display: block; padding: 80px; }
    .tall{ display: none; }
  }

  @media (max-width: 600px){
    .bg-head{ transform: scale(70%); width: 700px;}
    .long{ display: none; }
    .square{ display: none; }
    .tall{ display: block; padding: 0px; width: 300px; }
  }

  @keyframes Intro{
    0% { scale: 0%; }
    60% { scale: 105%; }
    100% { scale: 100%; }
  }

  @keyframes IntroBG{
    0% { scale: 0%; }
    100% { scale: 100%; }
  }

  @keyframes IntroBGIdle{
    0% { scale: 100%; }
    50% { scale: 95%; }
    100% { scale: 100%; }
  }

  .welcome {
    display: flex;
    width: 100%;
    height: 89vh;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    min-height: calc(75vh - 14rem);
    /* background: linear-gradient(var(--color-background), #f9eae4); */
  }

  .welcome-title {
    font-family: "Rustica", serif;
    color: var(--color-accent-b);
    font-size: clamp(70px, 10vw, 200px);
    font-weight: 400;
    display: flex;
    flex-direction: column;
  }
  .second-line {
    display: inline-block;
  }
  .narrow-space {
    display: inline-block;
    width: 0.35em;
  }
  .welcome-year {
    font-weight: 400;
    font-size: 0.65em;
    letter-spacing: -1%;
  }
  .big-header {
    text-align: center;
    width: 100%;
    padding-top: 2rem;
    padding-bottom: 2rem;
    background-color: var(--color-accent-a);
    color: var(--color-background);
  }
</style>
