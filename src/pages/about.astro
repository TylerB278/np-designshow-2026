---
import Layout from "../layouts/Layout.astro";
import AboutContent from "../content/other/about-top.md";
import BottomLeftContent from "../content/other/about-bottom-l.md";
import BottomRightContent from "../content/other/about-bottom-r.md";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
---

<Layout pageTitle="About">
  <div class="about-page">
    <h1 class="big-header">ABOUT</h1>
    <div class="mapDiv">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6132.24359659951!2d-74.08260849999999!3d41.742787099999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89dd227c0b6aaaab%3A0x43c624bd2971c6d7!2sWooster%20Hall!5e1!3m2!1sen!2sus!4v1777318564624!5m2!1sen!2sus" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="map"></iframe>
    </div>
    <div class="top-section">
      <AboutContent />
    </div>
    <div class="col-container">
      <div class="col"><BottomLeftContent /></div>
      <div class="col"><BottomRightContent /></div>
    </div>
  </div>
</Layout>

<style>
  .big-header{
    margin-top: 3rem;
  }

  @media (max-width: 500px){
    .big-header{
      margin: 0 auto;
      margin-top: 3rem;
    }
  }

  .map{
    width: 100%;
    height: 100%;
  }
  .mapDiv{
    max-width: 100%;
    width: 600px;
    height: 450px;
    margin-top: 50px;
  }
</style>

<style is:global>

  .about-page h3,
  .about-page h2 {
    font-family: "Rustica", serif;
    font-weight: 600;
  }

  .about-page h2 {
    position: relative;
    text-decoration: inherit;
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .about-page p {
    font-family: "Rustica", sans-serif;
    font-weight: 400;
    font-size: 1.25rem;
  }

  .about-page h3 {
    margin-bottom: 1rem;
    margin-top: 2rem;
    color: var(--color-accent-a);
  }
  .about-page li {
    font-family: "Rustica", sans-serif;
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 500px){
    .about-page p{
      font-size: 1rem;
    }
    .about-page li{
      font-size: 1rem;
    }
  }

  .about-page {
    width: 100%;
    max-width: 1300px;
    padding: 0 2rem;
  }
  .top-section {
    max-width: 600px;
  }

  .col-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(600px, 100%), 1fr));
    gap: 0rem 2rem;
    margin-bottom: 2rem;
  }

  .about-page .larger-text {
    font-size: 1.5rem;
  }
  .button-wrapper {
    margin: 2rem 0;
  }
</style>
