<style>

  .bio-container {
    display: flex;
    flex-direction: column;
    max-width: var(--size-page-width);
    margin: 0 var(--size-page-margin);
    gap: var(--size-page-margin);
  }

  .bio-image{
    background: linear-gradient(var(--color-background), var(--color-accent-a));
  }

  .bio-name {
    font-family: "rustica", serif;
    font-weight: 700;
    font-size: 3rem;
    color: var(--color-accent-c);
    width: fit-content;
  }
  
  .bio-image-wrapper {
    width: fit-content;
    align-self: center;
    margin-top: 1rem;
  }

  .bio-text {
    max-width: 650px;
    font-size: 1rem;
    line-height: 1.6;
    margin-top: 1rem;
  }
  .bio-content-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--size-page-margin);
    padding: 1rem 0;
  }
  .bio-info-group {
    line-height: 1.5;
    font-size: 1.25rem;
    margin-top: 2rem;
  }
  .bio-info-group p {
    font-family: "rustica", serif;
  }

  .footContain{
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 1rem;
  }
  .seperator{
    width: 60%;
    height: 30px;
    border-top: 10px solid var(--color-accent-a);
  }
  .botNav{
    display: flex;
    flex-flow: row wrap;
    justify-content: center;
    max-width: 970px;
  }

  .student{
    padding: 0.5rem;
    margin: 0.2rem;
    background-color: var(--color-accent-a);
    color: var(--color-background);
    text-decoration: none;
  } .student:hover{ background-color: var(--color-background); color: var(--color-accent-a); }

  @media (max-width: 500px){
    .student{
      padding: 0.3rem;
      font-size: 8pt;
    }
  }
  @media screen and (min-width: 900px) {
    .bio-container {
      flex-direction: row;
      margin: var(--size-page-margin) 0;
    }
    .bio-text {
      padding-right: 1rem;
    }
    .bio-image-wrapper {
      max-width: 450px;
      width: 100%;
    }
  }
</style>
