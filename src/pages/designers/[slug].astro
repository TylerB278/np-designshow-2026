---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import ButtonGroup from "../../components/ButtonGroup.astro";
import slugify from "../../helpers/slugify";
import ArrowButton from "../../components/ArrowButton.astro";
import { getPrevNext } from "../../helpers/getPrevNext";

export const getStaticPaths = async () => {
  const allPeople = await getCollection("people");
  return allPeople.map((item) => ({
    params: { slug: item.id },
  }));
};
const slug = Astro.params.slug;

const entry = await getEntry("people", slug);

const { prev, next } = await getPrevNext(slug);

if (!entry) {
  throw new Error(`Person not found for slug: ${slug}`);
}
---

<Layout pageTitle={entry.data.name}>
  <div class="bio-container">
    <div class="bio-image-wrapper">
      <Image
        class="bio-image"
        src={entry.data.headshot}
        alt={entry.data.name}
        transition:name={`photo-${slug}`}
        width={550}
      />
    </div>
    <div class="bio-content-wrapper">
      <div class="bio-text-wrapper">
        <h1 class="bio-name">
          <span class="star-after star-after-inline">{entry.data.name}</span>
        </h1>
        <div class="bio-info-group">
          <p>
            <span class="visually-hidden">Pronouns:</span>
            <span class="star-before">{entry.data.pronouns}</span>
          </p>
          <p>
            <span class="visually-hidden">Hometown:</span>
            <span class="star-before">{entry.data.location}</span>
          </p>
        </div>

        <p class="bio-text">{entry.data.bio}</p>
        <!-- <ArrowButton href="" color="accent-a">asdasd</ArrowButton> -->
      </div>
    </div>
  </div>
  <ButtonGroup>
    <Button href={"/projects/" + slugify(entry.data.title)} color="accent-a"
      ><span class="star-after">Thesis Project</span></Button
    >
    {
      entry.data.portfolio && (
        <Button href={entry.data.portfolio} color="accent-c">
          <span class="star-after">Portfolio Website</span>
        </Button>
      )
    }
  </ButtonGroup>
  <div class="footContain">
    <div class="botNav">
      <a class="student">Charlie Barnes</a>
      <a class="student">Marissa Barone</a>
      <a class="student">Tyler Boggi</a>
      <a class="student">Miles Cambridge</a>
      <a class="student">Samantha Cooper</a>
      <a class="student">Ginger Defino</a>
      <a class="student">Raquel Ferraro</a>
      <a class="student">Hart Frable</a>
      <a class="student">Sarah Friedlander</a>
      <a class="student">Ethan Gravel</a>
      <a class="student">Jubilee Harman</a>
      <a class="student">Kim Kedem</a>
      <a class="student">Kylee Henry</a>
      <a class="student">Maddie Hickey</a>
      <a class="student">Michael Losquardo</a>
      <a class="student">Kiaran Lynch</a>
      <a class="student">Clark Molfetta</a>
      <a class="student">Kristen Sauer</a>
      <a class="student">Angelina Savino</a>
      <a class="student">Christian Schaible</a>
      <a class="student">Brooke Scheuermann</a>
      <a class="student">Cindy Shochat</a>
      <a class="student">Ryan Stucker</a>
      <a class="student">Nicky Thomas</a>
      <a class="student">Affan Waheed</a>
      <a class="student">Bryce Walsh</a>
      <a class="student">Faith Wilson</a>
      <a class="student">Xindha Yaeger</a>
