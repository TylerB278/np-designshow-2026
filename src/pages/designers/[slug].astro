</Layout>

<style>
  .bio-container {
    display: flex;
    flex-direction: column;
    max-width: var(--size-page-width);
    margin: 0 var(--size-page-margin);
    gap: var(--size-page-margin);
  }

  .bio-name {
    font-family: "rustica", serif;
    font-weight: 700;
    font-size: 3rem;
  }
  
  .bio-image-wrapper {
    width: fit-content;
    align-self: center;
    margin-top: 1rem;
  }

  .bio-text {
    max-width: 650px;
    font-size: 1rem;
    line-height: 1.6;
    margin-top: 2rem;
  }
  .bio-content-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--size-page-margin);
    padding: 1rem 0;
  }
  .bio-info-group {
    line-height: 1.5;
    font-size: 1.25rem;
    margin-top: 2rem;
  }
  .bio-info-group p {
    font-family: "rustica", serif;
  }

  .footContain{
    display: flex;
    justify-content: center;
    width: 100%;
    background-color: var(--color-accent-a);
    padding: 1rem;
  }
  .botNav{
    display: flex;
    flex-flow: row wrap;
    justify-content: center;
    max-width: 970px;
  }

  .student{
    padding: 0.5rem;
    margin: 0.2rem;
    background-color: var(--color-background);
    color: var(--color-accent-a);
  } .student:hover{ background-color: var(--color-accent-a); color: var(--color-background); }

  @media screen and (min-width: 900px) {
    .bio-container {
      flex-direction: row;
      margin: var(--size-page-margin) 0;
    }
    .bio-text {
      padding-right: 1rem;
    }
    .bio-image-wrapper {
      max-width: 450px;
      width: 100%;
    }
  }
</style>
