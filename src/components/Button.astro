---
interface Props {
  href: string;
  color: string;
  thesisweb?: string;
  newtab?: string;
  compact?: boolean;
}
const { props } = Astro;
---

<a
  href={props.href}
  class:list={["btn", props.compact && "btn-compact", props.thesisweb ]}
  style=`--color-btn:var(--color-${props.color});`><slot /></a
>

<style>
  .btn {
    border: 5px solid var(--color-btn);
    color: var(--color-btn);
    padding: 0.75rem 1.5rem;
    line-height: 1.1;
    font-size: 2rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    font-family: "rustica", sans-serif;
  }
  .btn-compact {
    padding: 0.25rem 0.5rem;
  }
  .hide{
    display: none;
  }
  .btn:hover {
    background-color: var(--color-btn);
    color: var(--color-background);
  }

  @media (max-width: 900px) {
    .btn{
      font-size: 1.5rem;
    }
  }
</style>
