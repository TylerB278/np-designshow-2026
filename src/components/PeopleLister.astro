---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const people = await getCollection("people");
const peopleSorted = people.sort((a, b) => {
  const aLast = a.data.name.split(" ").pop() || "";
  const bLast = b.data.name.split(" ").pop() || "";
  return aLast > bLast ? 1 : -1;
});
---

<div class="people-list">
  {
    peopleSorted.map((person) => {
      return (
        <div class="person-contain">
          <a class="people-card" href={"/designers/" + person.id + "/"}>
            <div class="portrait">
              <Image
                class="people-card-image"
                src={person.data.headshot}
                alt={""}
                width={450}
                transition:name={`photo-${person.id}`}
              />
              <Image
                class="people-card-image-alt"
                src={person.data.headshotAlt}
                alt={""}
                width={600}
              />
            </div>
            <p class="people-card-name">
              <span class="star-after star-after-inline">{person.data.name}</span>
            </p>
          </a>
        </div>
      );
    })
  }
</div>

<style>
  .person-contain{ } 

  .portrait{
    /* outline-width: 3px;
    outline-bottom-width: 0px;
    outline-style: solid;
    outline-color: var(--color-accent-a); */
    background: linear-gradient(var(--color-background), var(--color-accent-a));
  }

  .people-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    max-width: var(--size-page-width);
    padding: 4rem;
    width: 100%;
  }

  @media (min-width: 791px) and (max-width: 1155px) {
    .people-card:nth-child(even){
      transform: translateY(60px);
    }
  }

  @media (min-width: 1156px){
    .people-card:nth-child(3n + 0){
      transform: translateY(80px);
    }
    .people-card:nth-child(3n - 1){
      transform: translateY(40px);
    }
  }

  .people-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    /* background-color: var(--color-background-transparent); */
  }
  .people-card-image,
  .people-card-image-alt {
    width: 100%;
    height: auto;
    transform-origin: bottom center;
    transition: transform 0.3s, opacity 0.1s;
  }
  .people-card-image-alt {
    position: absolute;
    transform: scale(105%);
    left: 0;
    top: 0;
    opacity: 0;
  }
  .person-contain:hover .people-card-image-alt,
  .person-contain:focus-visible .people-card-image-alt {
    opacity: 1;
    transform: scale(115%);
    
  }
  .person-contain:hover .people-card-image,
  .person-contain:focus-visible .people-card-image{
    opacity: 0;
    transform: scale(115%);
  }


  .people-card:hover .people-card-name,
  .people-card:focus-visible .people-card-name {
    color: var(--color-accent-a);
  }
  .people-card-name {
    font-family: "Rustica", serif;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    font-size: 2rem;
    display: inline;
    align-self: center;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  @media screen and (min-width: 700px) {
    .people-list {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      padding: 4rem;
    }
  }
</style>
