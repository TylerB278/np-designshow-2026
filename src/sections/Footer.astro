---
import { Image } from "astro:assets";
import footerImg from "../assets/footer.svg";
import BookLink from "../components/BookLink.astro";
---

<footer>
  <nav class="footer-nav">
    <div class="nav-left">
    </div>
    <div class="nav-right">
      <a>SUNY New Paltz Department of Design 2026</a>
    </div>
  </nav>

  <style>
    footer {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      background-color: var(--color-accent-a);
      color: var(--color-background);
    }
    .footer-nav {
      display: flex;
      flex-wrap: wrap;
      flex-direction: column;
      justify-content: center;
      align-self: flex-end;
      padding: 1rem;
      text-align: center;
      max-width: calc(var(--size-page-width) + 2 * var(--size-page-margin));
      /* padding: var(--size-page-margin); */
    }
    .nav-right {
      display: flex;
      padding-right: 1rem;
    }

    .footer-nav a {
      font-size: clamp(0.8rem, 2vw, 1.5rem);
      text-decoration: none;
      font-family: "Rustica", serif;
    }

    .footer-img {
      max-height: 300px;
      object-fit: cover;
    }

    .footer-img-container {
      position: relative;
    }

    @media screen and (min-width: 620px) {
      .footer-nav {
        flex-direction: row;
        justify-content: space-between;
      }
      .nav-left {
        text-align: left;
      }
      .nav-right {
        text-align: right;
      }
    }
  </style>
</footer>
